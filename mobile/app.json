{
  "expo": {
    "name": "PeopleWallet",
    "slug": "peoplewallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "scheme": "peoplewallet",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.peoplewallet.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PeopleWallet needs access to your microphone to record voice memos for creating contact cards.",
        "NSContactsUsageDescription": "PeopleWallet can import contacts to help you organize your network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.peoplewallet.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow PeopleWallet to access your microphone for voice memos."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "giphyApiKey": "xe5xAcrlPRn28VCMxvjngnNuiFUffupx",
      "eas": {
        "projectId": "49722b50-e850-4f07-8764-2a22e6bfb9ef"
      }
    },
    "owner": "ihsanduru"
  }
}
