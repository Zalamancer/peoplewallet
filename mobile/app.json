{
  "expo": {
    "name": "ProAnimate Connect",
    "slug": "proanimate-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "proanimate",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.proanimate.connect",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ProAnimate Connect needs access to your microphone to record voice memos for creating contact cards.",
        "NSContactsUsageDescription": "ProAnimate Connect can import contacts to help you organize your network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.proanimate.connect",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ProAnimate Connect to access your microphone for voice memos."
        }
      ]
    ],
    "extra": {}
  }
}
