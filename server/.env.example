# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://localhost:5432/peoplewallet
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peoplewallet
DB_USER=postgres
DB_PASSWORD=your_password_here

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Anthropic (Claude 3.5 Haiku for entity extraction)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Deepgram (Nova-2 for speech-to-text)
DEEPGRAM_API_KEY=your_deepgram_api_key

# JWT
JWT_SECRET=your_jwt_secret_change_this
JWT_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Dashboard (secret key for /admin/dashboard access)
ADMIN_SECRET=change_this_to_a_random_string

# Mixpanel
MIXPANEL_TOKEN=your_mixpanel_token

# Sentry
SENTRY_DSN=your_sentry_dsn

# Meta (for Instagram/Facebook oEmbed - optional)
META_APP_TOKEN=your_meta_app_token

# Campus Club Event Aggregator
# Google Dorking (pick one)
SERPAPI_KEY=your_serpapi_key
# OR Google Custom Search
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_ID=your_google_cse_id

# Instagram Scraping (pick one)
APIFY_TOKEN=your_apify_token
# OR RapidAPI (instagram-scraper-api2 recommended)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=instagram28.p.rapidapi.com

# Optional - location mapping on event detail pages
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Resend (email verification)
RESEND_API_KEY=your_resend_api_key
